DATABASE_URL="postgresql://tryon:tryon@localhost:5432/tryon?schema=public"
BACKEND_URL=http://localhost:8787
JWT_SECRET=change-this-to-a-long-random-secret
AI_PROVIDER=auto
CATVTON_URL=http://127.0.0.1:8788
CATVTON_WIDTH=512
CATVTON_HEIGHT=768
CATVTON_STEPS=25
CATVTON_GUIDANCE=2.5
# Enable to permit sending photos to paid cloud providers after local failure.
ALLOW_CLOUD_FALLBACK=false
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# Set AI_PROVIDER=fashn and provide this key for real try-on results.
FASHN_API_KEY=
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
CORS_ORIGIN=chrome-extension://*
